+    /**
+     * Connects to the controller at the configured auto select index, or to the best game controller
+     * if no index is configured. The index counts connected controllers in the order they were connected.
+     */
+    @Nullable
+    private Controller connectToAutoSelectController()
+    {
+        int targetIndex = (int) Config.CLIENT.options.autoSelectIndex.get().doubleValue();
+        if(targetIndex < 0)
+            return this.connectToBestGameController();
+
+        List<Number> jids = new ArrayList<>(this.createRawControllerMap().keySet());
+        jids.sort(Comparator.comparingLong(Number::longValue));
+        if(targetIndex < jids.size())
+        {
+            Number jid = jids.get(targetIndex);
+            Controller controller = this.createController(targetIndex, jid);
+            if(controller != null && this.setActiveController(controller) && this.activeController != null)
+            {
+                return controller;
+            }
+        }
+        Constants.LOG.warn("Could not connect to controller at index {}", targetIndex);
+        return null;
+    }
+
